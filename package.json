{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:unit": "NODE_ENV=test node --test --import tsx --import ./test/setup.ts \"test/unit/**/*.test.ts\"",
    "test:integration": "NODE_ENV=test node --test --import tsx --import ./test/setup.ts --import ./test/setup.db.ts \"test/integration/**/*.test.ts\"",
    "test:e2e": "NODE_ENV=test node --test --import tsx --import ./test/setup.ts --import ./test/setup.db.ts \"test/e2e/**/*.test.ts\"",
    "test:coverage": "NODE_ENV=test node --test --experimental-test-coverage --import tsx --import ./test/setup.ts --import ./test/setup.db.ts \"test/**/*.test.ts\"",
    "tdd": "NODE_ENV=test node --test --watch --import tsx --import ./test/setup.ts \"test/unit/**/*.test.ts\"",
    "build": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "commit": "cz",
    "prepare": "husky"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "commitizen": "4.3.2",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "handlebars": "4.7.9",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.10.4",
    "nodemailer": "10.0.13",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "cz-conventional-changelog": "3.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md,yml,yaml}": [
      "oxfmt"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@12.8.1"
}

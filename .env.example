# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# MongoDB (required)
MONGO_URI=mongodb://localhost:27017/auth_db

# JWT signing (JWT_PRIVATE_KEY is required in production)
# Generate with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
# and: openssl rsa -pubout -in private.pem -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=key-2026-11
JWT_RETIRED_PUBLIC_KEYS=
JWT_ISSUER=auth-service
JWT_ALLOW_EPHEMERAL_KEYS=false
JWT_SECRET=
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=86400

# Owner bootstrap (both or neither)
OWNER_EMAIL=
OWNER_PASSWORD=

# Public URLs and mail
PUBLIC_APP_URL=https://auth.example.com
APP_NAME=Auth Service
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@auth-service.com
TEMPLATES_PATH=./src/mail/templates

# Verification codes and holders
CODE_LENGTH=6
CODE_EXPIRATION_MS=300000
HOLDER_EXPIRATION_MS=300000

# Passwords and lockout
BCRYPT_SALT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=900000

# Shareable links
INVITATION_LINK_EXPIRATION_MS=604800000
PASSWORD_RESET_LINK_EXPIRATION_MS=3600000

# Per-route rate limiting
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_SIGNUP_WINDOW_MS=3600000
RATE_LIMIT_SIGNUP_MAX=3
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MS=3600000
RATE_LIMIT_FORGOT_PASSWORD_MAX=3

# Reverse proxy and CORS
TRUST_PROXY=false
CORS_ORIGINS=

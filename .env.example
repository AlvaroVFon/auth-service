# Template for local development: `cp .env.example .env` and `pnpm dev`.
# Every value here is safe for a laptop: MongoDB on localhost, MailHog on
# localhost:1025, ephemeral JWT keys and a throwaway MFA encryption key.
# Purpose, default and production requirement of each variable: README.md.
#
# Before deploying, do not copy this file blind: set NODE_ENV=production, real
# JWT_PRIVATE_KEY/JWT_PUBLIC_KEY, a real MFA_SECRET_ENCRYPTION_KEY, production
# URLs/CORS and HOST=0.0.0.0. See the "Deployment" section of README.md.

# APPLICATION
# Development is the default when unset; set `production` only when deploying.
# Never enable it in this file: `docker run --env-file .env` would inherit it.
# NODE_ENV=production
# Defaults to localhost. The production image already sets HOST=0.0.0.0.
# HOST=0.0.0.0
PORT=3000
APP_NAME=Auth Service
PUBLIC_APP_URL=http://localhost:3000
# `false`, `true` or a non-negative proxy hop count. Only enable it behind a proxy.
TRUST_PROXY=false
# Comma-separated browser origins. Empty means every browser origin is rejected.
CORS_ORIGINS=http://localhost:5173

# DATABASE
# Required: the service refuses to start without a reachable MongoDB URI.
MONGO_URI=mongodb://localhost:27017/auth_db

# JWT (RS256)
# Local only: every process generates its own key pair, so tokens and JWKS differ
# between restarts and replicas. NODE_ENV=production rejects it even with the flag set.
JWT_ALLOW_EPHEMERAL_KEYS=true
JWT_ISSUER=auth-service
# Access token TTL in seconds.
JWT_EXPIRATION=3600
# Refresh token TTL in seconds.
JWT_REFRESH_EXPIRATION=86400
# Production: replace the ephemeral pair with real PEM keys (`\n` for line breaks).
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Defaults to the RFC 7638 thumbprint of the public key.
# JWT_KEY_ID=2026-11
# JSON array of {"kid","publicKey"} entries; only needed while rotating keys.
# JWT_RETIRED_PUBLIC_KEYS=[]
# Legacy HS256 bridge for tokens without audience. Leave unset.
# JWT_SECRET=
# Deprecated alias of JWT_REFRESH_EXPIRATION. Leave unset.
# JWT_REFRESH_EXPIRES_IN=

# SMTP (MailHog from docker-compose: SMTP on 1025, web UI on 8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@auth-service.com

# TEMPLATES RENDERING
TEMPLATES_PATH=./src/mail/templates

# CODE GENERATION
CODE_LENGTH=6
CODE_EXPIRATION_MS=300000

# HOLDER LIFECYCLE
HOLDER_EXPIRATION_MS=300000

# ACCOUNT LOCKOUT
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=900000
# Lower it (4) to speed up the test suite; 10 is the production default.
BCRYPT_SALT_ROUNDS=10

# SESSIONS
MAX_SESSIONS_PER_USER=50

# PER-ROUTE RATE LIMITING (relaxed windows so local testing does not self-throttle)
RATE_LIMIT_LOGIN_WINDOW_MS=5000
RATE_LIMIT_LOGIN_MAX=15
RATE_LIMIT_SIGNUP_WINDOW_MS=5000
RATE_LIMIT_SIGNUP_MAX=15
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MS=5000
RATE_LIMIT_FORGOT_PASSWORD_MAX=10
RATE_LIMIT_REFRESH_WINDOW_MS=5000
RATE_LIMIT_REFRESH_MAX=20
RATE_LIMIT_MFA_VERIFY_WINDOW_MS=5000
RATE_LIMIT_MFA_VERIFY_MAX=20

# SHAREABLE LINKS
INVITATION_LINK_EXPIRATION_MS=604800000
PASSWORD_RESET_LINK_EXPIRATION_MS=3600000

# AUDIT
AUDIT_RETENTION_DAYS=90

# MFA
# Local-only base64 key (32 bytes) that encrypts TOTP secrets at rest. Generate a new
# one for any real deployment; without it TOTP secrets are stored as plaintext.
MFA_SECRET_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
MFA_CHALLENGE_EXPIRATION=300

# TELEGRAM NOTIFICATIONS (optional; empty disables the integration)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_TIMEOUT_MS=3000

# OWNER BOOTSTRAP (optional; when unset no owner is provisioned)
# Set both or neither, then run `pnpm dev` or `pnpm bootstrap:owner`.
# The password needs 8+ characters with lowercase, uppercase, a digit and a symbol.
# OWNER_EMAIL=owner@home.example
# OWNER_PASSWORD=ChangeMe123!
